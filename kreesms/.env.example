# ---- Server-only. NEVER prefix these with NEXT_PUBLIC_ ----
# Database (PostgreSQL — local or Supabase pooler)
# Local: DB_HOST=localhost DB_PORT=5432 DB_NAME=sms-backend DB_USER=postgres DB_SSL=false
# Supabase (DB-only, no Supabase Auth): use the pooler values from
# Supabase Dashboard -> Settings -> Database -> Connection Pooling, e.g.
# DB_HOST=aws-0-xx.pooler.supabase.com DB_PORT=6543 DB_NAME=postgres
# DB_USER=postgres.xxxxxxxxx DB_SSL=true (DB_PASS = your Supabase DB password)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms-backend
DB_USER=postgres
DB_PASS=change-me
DB_SSL=false

# Auth
JWT_SECRET=replace-with-min-32-char-secret
JWT_EXPIRES_IN=7d

# Aakash SMS gateway — server-only, read exclusively in src/lib/aakash.js
AAKASH_SMS_TOKEN=
AAKASH_API_URL=https://sms.aakashsms.com/sms/v3/send
AAKASH_CREDIT_URL=https://sms.aakashsms.com/sms/v4/available-credit

# SMTP for OTP mail (optional — falls back to console mock log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Vercel Cron protection (generate: openssl rand -hex 32)
CRON_SECRET=change-me-in-production

# Public third-party gateway (POST /api/public/send-sms) — server-only.
# Pepper for API-key hashes + AES key for secret envelopes (generate:
# openssl rand -base64 48). WARNING: rotating it invalidates all issued keys.
SMS_HMAC_PEPPER=change-me-in-production
# Upstash Redis REST for cross-instance rate limiting (optional locally —
# falls back to in-memory; required before going public on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NODE_ENV=development
